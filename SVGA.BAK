void Modo_video(int modo)
{
Video_banco=255;//des-inicializo
if (modo<0x100) {
r.x.ax=modo;
_go32_dpmi_simulate_int(0x10,&r);
                 } else
                 {
//-----------------Pongo el modo VESA y scan 1024-------------
r.x.ax=0x4F02;
r.x.bx=modo;//640x480x256
_go32_dpmi_simulate_int(0x10,&r);
                } 
}
