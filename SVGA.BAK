  void putpixel(int x,int y,unsigned char color,unsigned char *donde)
{
donde[(MAX_X*y)+x]=color;
}


  char getpixel(int x,int y,unsigned char *donde)
{
return donde[(MAX_X*y)+x];
}
  void Hline (int x,int y,int l,unsigned char color,unsigned char *donde)
{
register int i;
char *aux;
aux=donde+(MAX_X*y)+x;
for (i=0;i<l;i++) aux[i]=color;
}
  void Vline (int x,int y,int l,unsigned char color,unsigned char *donde)
{
register int i;
char *aux;
aux=&donde[(MAX_X*y)+x];
for (i=0;i<l;i++) aux[MAX_X*i]=color;
}

  void putico(int x,int y,int LX,int LY,unsigned char *origen,unsigned char *destino)
{
register int cx,cy;
destino+=(y*MAX_X)+x;
for (cy=y;cy<LY+y;cy++){
 for (cx=x;cx<LX+x;cx++) {                  
                  if (*origen!=0) *destino=*origen;
                  origen++;destino++;
                         }
    destino+=(MAX_X-LX);}
}

  void putico_sombra(int x,int y,int LX,int LY,unsigned char *origen,unsigned char *destino)
{
register int cx,cy;
unsigned char color;
destino+=(y*MAX_X)+x;
for (cy=y;cy<LY+y;cy++){
 for (cx=x;cx<LX+x;cx++) {
                  if (*origen!=0)
                   {
                   color=*destino+GRADIENTE;
                   if (color<128) color+=128;
                   *destino=color;
                   }
                  origen++;destino++;
                      }
 destino+=(MAX_X-LX);}
}
  void putico_CTRL(signed int x,signed int y,int LX,int LY,unsigned char *origen,unsigned char *destino)
{
register int cx,cy;
destino+=(y*MAX_X)+x;
for (cy=y;cy<LY+y;cy++){
 for (cx=x;cx<LX+x;cx++) {                  
                  if (*origen!=0)
                   if( (cx>=0) && (cx<MAX_X) && (cy>=0) && (cy<MAX_Y) )                  
                      //putpixel (cx,cy,*origen,destino);
                      *destino=*origen;
                  origen++;destino++;
                         }
    destino+=(MAX_X-LX);}
}
