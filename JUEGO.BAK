void disk_paleta(char fichero[])
{
FILE *hand;
hand=fopen(fichero,"rb");
fseek(hand,-768,SEEK_END);//siempre esta al final y ocupa 768
fread(paleta,1,768,hand);
fclose(hand);
  movedata (ds,(int)paleta,ds,(int)paleta_back,768);
}
